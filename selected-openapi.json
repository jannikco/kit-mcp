{
  "openapi": "3.1.0",
  "info": {
    "title": "Kit (ConvertKit) selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.kit.com/v4"
    }
  ],
  "paths": {
    "/subscribers": {
      "get": {
        "operationId": "kit_list_subscribers",
        "summary": "Read a page of subscribers with optional email filtering.",
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "email_address",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "kit_create_inactive_subscriber",
        "summary": "Create an inactive subscriber; this does not subscribe them to email marketing.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email_address": {
                    "type": "string",
                    "format": "email"
                  },
                  "first_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state": {
                    "const": "inactive",
                    "default": "inactive"
                  }
                },
                "required": [
                  "email_address",
                  "state"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kit-Api-Key"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
